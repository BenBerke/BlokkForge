[submodule "vendored/SDL"]
	path = vendored/SDL
	url = https://github.com/libsdl-org/SDL.git
[submodule "vendored/SDL_image"]
	path = vendored/SDL_image
	url = https://github.com/libsdl-org/SDL_image.git
[submodule "vendored/xsimd"]
	path = vendored/xsimd
	url = https://github.com/xtensor-stack/xsimd.git
[submodule "vendored/BFCL"]
	path = vendored/BFCL
	url = https://github.com/hammykat/BFCL.git
[submodule "vendored/glfw"]
	path = vendored/glfw
	url = https://github.com/glfw/glfw
